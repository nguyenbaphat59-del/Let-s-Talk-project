# Backend runtime
NODE_ENV=development
PORT=1702

# Supabase project URL and low-privilege publishable key (anon-scoped by RLS)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Local frontend origin. Set only for local development; production uses same-origin routing.
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
